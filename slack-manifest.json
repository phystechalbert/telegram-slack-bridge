{
  "display_information": {
    "name": "Telegram Bridge"
  },
  "features": {
    "bot_user": {
      "display_name": "Telegram Bridge",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "groups:history",
        "groups:read",
        "files:read",
        "files:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://bridge.example.invalid/slack",
      "bot_events": [
        "message.groups"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
